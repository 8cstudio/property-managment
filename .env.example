# Pooled runtime connection. Direct connection is for migrations, the worker, and LISTEN/NOTIFY.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ezzi_dev
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ezzi_dev

STORAGE_DRIVER=local
EMAIL_DRIVER=console
CACHE_DRIVER=memory
RATE_LIMIT_DRIVER=memory

# local filesystem root for STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
