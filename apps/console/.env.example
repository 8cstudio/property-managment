# Supabase (console API — enables supabase mode when all are set)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres: use the pooler (6543) or direct (5432) connection string from the dashboard
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional overrides for first-run platform admin (Supabase + local)
EZZI_SUPER_ADMIN_EMAIL=admin@ezzi.app
EZZI_SUPER_ADMIN_PASSWORD=admin12345
EZZI_SUPER_ADMIN_NAME=Platform Admin

SESSION_SECRET=change-me-in-production
